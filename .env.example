# GEMINI_API_KEY: Required for Gemini AI API calls if AI extensions are added.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_PATH: Path to the SQLite database file (defaults to ./data/app.db).
DATABASE_PATH="./data/app.db"

# UPLOAD_DIR: Private directory for uploaded supporting documents outside public web root.
UPLOAD_DIR="./storage/uploads"

# MAX_FILE_SIZE_MB: Maximum upload size per file in megabytes (default: 10).
MAX_FILE_SIZE_MB=10

# ADMIN_SETUP_PASSCODE: Required for first-admin setup in production; set a long random value.
# In development it is optional.
ADMIN_SETUP_PASSCODE=
